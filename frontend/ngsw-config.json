{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/index.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/assets/**",
          "/*.(svg|png|jpg|jpeg|gif|webp)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-spaces",
      "urls": ["**/api/spaces"],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "10m",
        "timeout": "4s",
        "strategy": "freshness"
      }
    }
  ]
}
